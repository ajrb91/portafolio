        <process id="501bce07-bed3-4cab-9be3-6bf6cdc16b64" name="P00_Panama_Purchase" xmlns="http://www.blueprism.co.uk/product/process"><process name="P00_Panama_Purchase" version="1.0" bpversion="7.4.1.15931" narrative="Main task which is capable of invoque every single task in order to run the whole logic about Panama Purchase process" byrefcollection="true" processrunningmessage="" disableversioning="false"><view><camerax>294.599976</camerax><cameray>-20</cameray><zoom version="2">0.9375</zoom></view><preconditions /><endpoint narrative="" /><subsheet subsheetid="5c7c28b0-9398-4faf-b692-db85c700139e" type="Normal" published="False"><name>Start Up</name><view><camerax>0</camerax><cameray>189</cameray><zoom version="2">1.25</zoom></view></subsheet><subsheet subsheetid="818c55a7-e531-41fa-9684-096150233871" type="Normal" published="False"><name>Populate Queue</name><view><camerax>0</camerax><cameray>0</cameray><zoom version="2">1.25</zoom></view></subsheet><subsheet subsheetid="cf716ed6-11dc-4ef0-8c38-562d4971f522" type="Normal" published="False"><name>Process Core</name><view><camerax>0</camerax><cameray>21</cameray><zoom version="2">1.25</zoom></view></subsheet><subsheet subsheetid="76f21efb-d05c-4beb-ab4a-54cf55ecca57" type="Normal" published="False"><name>Prepare the report and send it</name><view><camerax>0</camerax><cameray>0</cameray><zoom version="2">1.25</zoom></view></subsheet><subsheet subsheetid="fe712a0d-324d-4648-baa9-9b08b247de44" type="Normal" published="False"><name>Mark Item As Completed</name><view><camerax>32</camerax><cameray>42</cameray><zoom version="2">1.25</zoom></view></subsheet><subsheet subsheetid="b4d40402-d648-4d72-b23b-2ec7e5b24cac" type="Normal" published="False"><name>Mark Item As Exception</name><view><camerax>-8</camerax><cameray>63</cameray><zoom version="2">1.25</zoom></view></subsheet><subsheet subsheetid="ed14d0af-54ba-4d3a-9ab2-ccf5a17c04e7" type="Normal" published="False"><name>Reset Global Data</name><view><camerax>0</camerax><cameray>0</cameray><zoom version="2">1.25</zoom></view></subsheet><subsheet subsheetid="4477334a-732f-4732-8c01-0bad20844fec" type="Normal" published="False"><name>Close Down</name><view><camerax>0</camerax><cameray>0</cameray><zoom version="2">1.25</zoom></view></subsheet><stage stageid="dd411000-60fc-4014-a332-70441e3ce961" name="Start" type="Start"><display x="-30" y="-270" /><onsuccess>f1f9ec82-de3d-42bb-80c1-e0f3f0a3062e</onsuccess></stage><stage stageid="26b9e521-2ae5-4ff2-8ab4-e0023caeca31" name="End" type="End"><display x="480" y="-270" /></stage><stage stageid="0b515485-2292-4f94-86fa-1951ced4f82f" name="Stage1" type="ProcessInfo"><display x="-195" y="-195" w="150" h="180" /></stage><stage stageid="29e1519b-ff45-435f-87fe-172736ed5cd0" name="Process Core" type="SubSheetInfo"><subsheetid>cf716ed6-11dc-4ef0-8c38-562d4971f522</subsheetid><display x="-180" y="-135" w="150" h="90" /></stage><stage stageid="7f29722e-b36f-4894-a7ad-4e6352cac057" name="Start" type="Start"><subsheetid>cf716ed6-11dc-4ef0-8c38-562d4971f522</subsheetid><display x="15" y="-165" /><onsuccess>12980c66-ebea-4c71-be31-a585760b7a47</onsuccess></stage><stage stageid="cf1b6f93-c799-4331-b395-a7c077ee3e99" name="End" type="End"><subsheetid>cf716ed6-11dc-4ef0-8c38-562d4971f522</subsheetid><display x="15" y="135" /></stage><stage stageid="6ac5b92d-5af1-4ff8-9523-b0f67859cd53" name="Start Up" type="SubSheetInfo"><subsheetid>5c7c28b0-9398-4faf-b692-db85c700139e</subsheetid><display x="-195" y="-60" w="150" h="90" /></stage><stage stageid="83b35c4b-db64-440a-b367-96457efb860a" name="Start" type="Start"><subsheetid>5c7c28b0-9398-4faf-b692-db85c700139e</subsheetid><display x="15" y="-105" /><onsuccess>13bc188f-6b68-4c35-8df0-fafa5cfd62c6</onsuccess></stage><stage stageid="70e08fe5-4718-42bf-951f-2142ff48f249" name="End" type="End"><subsheetid>5c7c28b0-9398-4faf-b692-db85c700139e</subsheetid><display x="15" y="465" /><outputs><output type="collection" name="Advance Search Parameters Stage 1" stage="Advance Search Parameters Stage 1" /></outputs></stage><stage stageid="f1f9ec82-de3d-42bb-80c1-e0f3f0a3062e" name="Start Up" type="SubSheet"><loginhibit onsuccess="true" /><narrative>sasas</narrative><display x="-30" y="-180" w="120" h="90" /><outputs><output type="collection" name="Advance Search Parameters Stage 1" friendlyname="Advance Search Parameters Stage 1" stage="Advance Search Parameters Stage 1" /></outputs><onsuccess>91f0ee8e-28f2-4059-b23b-724b16e6e1e7</onsuccess><processid>5c7c28b0-9398-4faf-b692-db85c700139e</processid></stage><stage stageid="b77d3f4a-8c94-4472-871c-5f9737b20446" name="Populate Queue" type="SubSheetInfo"><subsheetid>818c55a7-e531-41fa-9684-096150233871</subsheetid><display x="-195" y="-75" w="150" h="90" /></stage><stage stageid="e064aa0f-6669-4d21-b321-a41860ee62ee" name="Start" type="Start"><subsheetid>818c55a7-e531-41fa-9684-096150233871</subsheetid><display x="15" y="-105" /><inputs><input type="collection" name="Advance Search Parameters Stage 1" stage="Advance Search Parameters Stage 1" /></inputs><onsuccess>fab03597-2cc5-437d-a16e-0ef6663a7451</onsuccess></stage><stage stageid="2f00c0c6-df54-4938-be35-87c8bf6221c0" name="End" type="End"><subsheetid>818c55a7-e531-41fa-9684-096150233871</subsheetid><display x="15" y="75" /></stage><stage stageid="50255a99-539b-4bce-915f-52a3e0ccf694" name="Populate Queue" type="SubSheet"><loginhibit onsuccess="true" /><display x="-30" y="0" w="120" h="90" /><inputs><input type="collection" name="Advance Search Parameters Stage 1" friendlyname="Advance Search Parameters Stage 1" expr="[Advance Search Parameters Stage 1]" /></inputs><onsuccess>0d62ca56-d374-4f75-96f9-7ecf2aa6e77a</onsuccess><processid>818c55a7-e531-41fa-9684-096150233871</processid></stage><stage stageid="0d62ca56-d374-4f75-96f9-7ecf2aa6e77a" name="Get next item" type="Action"><narrative>This action gets the next item to be worked from the queue, returning its details and locking it so no other case can work it.

Items with higher priorities (lower numerical value) are processed first. Where the priority is the same, the next item is the one that has been in the queue the longest,  is not already locked, and is not already completed.

The Item ID returned is used to make further calls to update the work status for that item. It may be empty, in which case there are no items available. This can mean either a) the queue is empty, or b) the queue is not running. This mechanism can be used to cleanly stop all processes working a particular queue at the end of the next case. Items that have a 'deferred' time set will not be returned unless that time has been reached.</narrative><display x="-30" y="120" /><inputs><input type="text" name="Queue Name" friendlyname="Queue Name" narrative="The name of the queue" expr="&quot;Purchases&quot;" /><input type="text" name="Key Filter" friendlyname="Key Filter" narrative="Optionally, a key value to filter by. Only items with this key value will be considered." expr="" /><input type="text" name="Tag Filter" friendlyname="Tag Filter" narrative="Optionally, a tag mask to filter by. This can consist of any number of tag searches - each term can be separated by a semi-colon and they are all applied to the search (ie. they are AND'ed terms not OR'ed terms). For example, &quot;Account: Joint; -Balance: Overdrawn; Card: *Visa*&quot; will include any items which match all the terms, ie. every item must have an 'Account: Joint' tag applied, no item can have a 'Balance: Overdrawn' tag applied, every item must have a tag applied which starts with 'Card: ' and then contains the text 'Visa'." expr="" /><input type="text" name="Sort Order" friendlyname="Sort Order" narrative="Sort order method (Priority, SLA, PriorityAndSLA)" lookupValue="Priority" lookupType="WorkQueueSortTypes" /></inputs><outputs><output type="text" name="Item ID" friendlyname="Item ID" narrative="The ID of the item retrieved - empty if there are none available." stage="Item ID" /><output type="collection" name="Data" friendlyname="Data" narrative="The data associated with the item - a single collection row." stage="Item data" /><output type="text" name="Status" friendlyname="Status" narrative="The status of the item." stage="Item Status" /><output type="number" name="Attempts" friendlyname="Attempts" narrative="The number of attempts already made to work this item." stage="Item Attempts" /></outputs><onsuccess>50f4dcf0-7ab2-44c3-9b1c-39e0a57d6890</onsuccess><resource object="Blueprism.Automate.clsWorkQueuesActions" action="Get Next Item" /></stage><stage stageid="50f4dcf0-7ab2-44c3-9b1c-39e0a57d6890" name="Got Item?" type="Decision"><display x="105" y="120" /><decision expression="[Item ID]&lt;&gt;&quot;&quot;" /><ontrue>7cd773ed-c953-4a77-8cfd-9a1c49fd9e3d</ontrue><onfalse>6e67925b-49e9-42fb-a0bb-4935960c702a</onfalse></stage><stage stageid="fbda14a4-d33d-4fd0-b87f-937d60167e14" name="Queue scope" type="Block"><loginhibit onsuccess="true" /><display x="15" y="195" w="195" h="255" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="7cd773ed-c953-4a77-8cfd-9a1c49fd9e3d" name="Process Core" type="SubSheet"><loginhibit onsuccess="true" /><display x="105" y="285" w="120" h="90" /><onsuccess>8a7eee7b-b9d7-459a-af0a-29316f37ed77</onsuccess><processid>cf716ed6-11dc-4ef0-8c38-562d4971f522</processid></stage><stage stageid="bbf8e250-03cb-4827-851f-33ba4d5a65de" name="Mark Item As Completed" type="SubSheetInfo"><subsheetid>fe712a0d-324d-4648-baa9-9b08b247de44</subsheetid><narrative>Marks the current work queue item as complete</narrative><display x="-180" y="-60" w="150" h="90" /></stage><stage stageid="db2c11f3-7235-4ca3-8ab5-9f80fd79309d" name="Start" type="Start"><subsheetid>fe712a0d-324d-4648-baa9-9b08b247de44</subsheetid><display x="15" y="-105" /><onsuccess>e891b3f9-9b13-44ca-ad85-af39521fbf02</onsuccess></stage><stage stageid="a1c65acc-f763-449a-8cbb-0463b62d5da3" name="End" type="End"><subsheetid>fe712a0d-324d-4648-baa9-9b08b247de44</subsheetid><display x="15" y="135" /></stage><stage stageid="cf48943e-32d9-40c6-ad69-4155eb6e184a" name="Mark Item As Completed" type="SubSheet"><loginhibit onsuccess="true" /><display x="300" y="405" w="120" h="90" /><onsuccess>4a8ee444-9b3a-45ff-9a14-a6cec56f4a7d</onsuccess><processid>fe712a0d-324d-4648-baa9-9b08b247de44</processid></stage><stage stageid="4a8ee444-9b3a-45ff-9a14-a6cec56f4a7d" name="Anchor2" type="Anchor"><loginhibit onsuccess="true" /><display x="480" y="405" w="10" h="10" /><onsuccess>e36d8c8c-b4d1-4c78-9646-0bbe781726a6</onsuccess></stage><stage stageid="02c4de34-1f97-414c-a79f-d1a8433d19c5" name="Reset Global Data" type="SubSheetInfo"><subsheetid>ed14d0af-54ba-4d3a-9ab2-ccf5a17c04e7</subsheetid><narrative>This page is only used to reset global data items</narrative><display x="-180" y="-75" w="150" h="90" /></stage><stage stageid="d6cc176d-fba8-46a0-9bc0-f95a70536ffa" name="Start" type="Start"><subsheetid>ed14d0af-54ba-4d3a-9ab2-ccf5a17c04e7</subsheetid><display x="15" y="-105" /><onsuccess>a25baaea-e1df-4d07-a3c5-0bfb312bbdc4</onsuccess></stage><stage stageid="60a4bfe2-d57d-4e9e-ad92-2ce39ed1039e" name="End" type="End"><subsheetid>ed14d0af-54ba-4d3a-9ab2-ccf5a17c04e7</subsheetid><display x="15" y="75" /></stage><stage stageid="e36d8c8c-b4d1-4c78-9646-0bbe781726a6" name="Reset Global Data" type="SubSheet"><loginhibit onsuccess="true" /><narrative>This page is only used to reset global data items</narrative><display x="480" y="285" w="120" h="90" /><onsuccess>912ba3ed-5a78-4f14-a9d2-bdd1b3e7e89b</onsuccess><processid>ed14d0af-54ba-4d3a-9ab2-ccf5a17c04e7</processid></stage><stage stageid="030b32a1-8db0-4c3b-b06c-0fe0d8e55c22" name="Close Down" type="SubSheet"><display x="480" y="-180" w="120" h="90" /><onsuccess>26b9e521-2ae5-4ff2-8ab4-e0023caeca31</onsuccess><processid>4477334a-732f-4732-8c01-0bad20844fec</processid></stage><stage stageid="e6c156d6-a87f-4c3f-a88e-5d88145f83b9" name="Stop?" type="Decision"><display x="480" y="120" w="90" h="60" /><decision expression="IsStopRequested() OR [Stop After Items]=0 OR LocalTime()&gt;[Stop After Time]" /><ontrue>c5f74a2e-40d3-4aaa-adf0-4b0ddb20acca</ontrue><onfalse>3054ed7b-8e63-4e9b-83db-8a931d3bf6fc</onfalse></stage><stage stageid="912ba3ed-5a78-4f14-a9d2-bdd1b3e7e89b" name="Count Items" type="Calculation"><display x="480" y="195" w="90" h="30" /><onsuccess>e6c156d6-a87f-4c3f-a88e-5d88145f83b9</onsuccess><calculation expression="[Stop After Items]-1" stage="Stop After Items" /></stage><stage stageid="6e67925b-49e9-42fb-a0bb-4935960c702a" name="Anchor1" type="Anchor"><loginhibit onsuccess="true" /><display x="105" y="0" w="10" h="10" /><onsuccess>c5f74a2e-40d3-4aaa-adf0-4b0ddb20acca</onsuccess></stage><stage stageid="8a7eee7b-b9d7-459a-af0a-29316f37ed77" name="Anchor3" type="Anchor"><loginhibit onsuccess="true" /><display x="105" y="405" w="10" h="10" /><onsuccess>cf48943e-32d9-40c6-ad69-4155eb6e184a</onsuccess></stage><stage stageid="c5f74a2e-40d3-4aaa-adf0-4b0ddb20acca" name="Prepare the report and send it" type="SubSheet"><loginhibit onsuccess="true" /><display x="480" y="0" w="120" h="90" /><onsuccess>fab45bfb-c108-4c4c-b407-2e8afa5faa73</onsuccess><processid>76f21efb-d05c-4beb-ab4a-54cf55ecca57</processid></stage><stage stageid="89e97f5a-50fa-4d66-a865-72589fb92b74" name="Recover" type="Recover"><display x="60" y="420" /><onsuccess>b734558f-8b47-4b39-a17d-57f18861848c</onsuccess></stage><stage stageid="1a5f147e-1578-4079-a5d1-8bd8ab02fd6a" name="Resume" type="Resume"><display x="60" y="570" /><onsuccess>81cd6f7d-45ff-48bd-9d7b-3489a1ea6c79</onsuccess></stage><stage stageid="81cd6f7d-45ff-48bd-9d7b-3489a1ea6c79" name="Mark Item As Exception" type="SubSheet"><display x="300" y="570" w="120" h="90" /><onsuccess>0c243cd6-d625-4d5f-8754-e6298c946fab</onsuccess><processid>b4d40402-d648-4d72-b23b-2ec7e5b24cac</processid></stage><stage stageid="0c243cd6-d625-4d5f-8754-e6298c946fab" name="anchor14" type="Anchor"><display x="480" y="570" w="10" h="10" /><onsuccess>4a8ee444-9b3a-45ff-9a14-a6cec56f4a7d</onsuccess></stage><stage stageid="b734558f-8b47-4b39-a17d-57f18861848c" name="Exception Data" type="MultipleCalculation"><display x="60" y="495" w="90" h="60" /><onsuccess>1a5f147e-1578-4079-a5d1-8bd8ab02fd6a</onsuccess><steps><calculation expression="ExceptionType()" stage="Exception Type" /><calculation expression="ExceptionDetail()" stage="Exception Detail" /></steps></stage><stage stageid="13bc188f-6b68-4c35-8df0-fafa5cfd62c6" name="Email Monitor" type="Action"><subsheetid>5c7c28b0-9398-4faf-b692-db85c700139e</subsheetid><loginhibit onsuccess="true" /><display x="15" y="-45" /><inputs><input type="text" name="Server" friendlyname="Server" expr="[IMAP Server]" /><input type="number" name="IMAP Port" friendlyname="IMAP Port" expr="[IMAP Port]" /><input type="text" name="Email user" friendlyname="Email user" expr="[Email user]" /><input type="password" name="Email pass" friendlyname="Email pass" expr="[Email pass]" /><input type="text" name="Subject To Match" friendlyname="Subject To Match" expr="[Subject To Match]" /><input type="number" name="Time Out" friendlyname="Time Out" expr="[Time out]" /><input type="number" name="Poll" friendlyname="Poll" expr="[Poll]" /></inputs><outputs><output type="flag" name="Found" friendlyname="Found" stage="Found" /></outputs><onsuccess>9fa3d2a1-2647-4eed-b81d-eccac58372b9</onsuccess><resource object="BO_Mail" action="Inbox Monitor" /></stage><stage stageid="ce9ff7d4-b065-4383-96d3-cd484e175c02" name="Launch Web App" type="Action"><subsheetid>5c7c28b0-9398-4faf-b692-db85c700139e</subsheetid><loginhibit onsuccess="true" /><display x="15" y="135" /><inputs><input type="text" name="Panama Purchase URL" friendlyname="Panama Purchase URL" expr="[Panama Purchases URL]" /></inputs><onsuccess>a648e41a-ac43-4f63-88bb-a5160d102ac0</onsuccess><resource object="BO_Web_PanamaPurchase" action="Launch Web Panama Purchase" /></stage><stage stageid="a648e41a-ac43-4f63-88bb-a5160d102ac0" name="Search Items by Filter" type="Action"><subsheetid>5c7c28b0-9398-4faf-b692-db85c700139e</subsheetid><loginhibit onsuccess="true" /><display x="15" y="195" /><onsuccess>367626a0-c5fb-49c8-a19b-2ff24ce981a5</onsuccess><resource object="BO_Web_PanamaPurchase" action="Search Items by Filter" /></stage><stage stageid="367626a0-c5fb-49c8-a19b-2ff24ce981a5" name="Scrape items from Panama Compras" type="Action"><subsheetid>5c7c28b0-9398-4faf-b692-db85c700139e</subsheetid><loginhibit onsuccess="true" /><display x="15" y="255" /><outputs><output type="collection" name="Advance Search Parameters Final" friendlyname="Advance Search Parameters Final" stage="Advance Search Parameters Stage 1" /></outputs><onsuccess>d782b00d-90f2-4aec-9d7b-ae330b06abf6</onsuccess><resource object="BO_Web_PanamaPurchase" action="Scrape items from Panama Compras" /></stage><stage stageid="d782b00d-90f2-4aec-9d7b-ae330b06abf6" name="Create Report" type="Action"><subsheetid>5c7c28b0-9398-4faf-b692-db85c700139e</subsheetid><loginhibit onsuccess="true" /><display x="15" y="315" /><inputs><input type="text" name="File Name" friendlyname="File Name" expr="[File Name]" /><input type="text" name="File Path" friendlyname="File Path" expr="[File Path]" /></inputs><outputs><output type="text" name="Report Name" friendlyname="Report Name" stage="File Name" /></outputs><onsuccess>d48f22a1-c560-4333-9416-d05ca0f6e5ea</onsuccess><resource object="BO_Excel_Report" action="Create Report" /></stage><stage stageid="d48f22a1-c560-4333-9416-d05ca0f6e5ea" name="Fill Report Stage 1" type="Action"><subsheetid>5c7c28b0-9398-4faf-b692-db85c700139e</subsheetid><loginhibit onsuccess="true" /><display x="15" y="375" /><inputs><input type="text" name="File Name" friendlyname="File Name" expr="[File Name]" /><input type="text" name="File Path" friendlyname="File Path" expr="[File Path]" /><input type="collection" name="Advance Search Parameters Temporal" friendlyname="Advance Search Parameters Temporal" expr="[Advance Search Parameters Stage 1]" /></inputs><onsuccess>a054523b-61c5-416e-ae1d-0c96e715309e</onsuccess><resource object="BO_Excel_Report" action="Fill Report Stage 1" /></stage><stage stageid="dfdf6a10-a4a6-4fdc-961d-c306ac697a7f" name="Close Down" type="SubSheetInfo"><subsheetid>4477334a-732f-4732-8c01-0bad20844fec</subsheetid><display x="-180" y="-75" w="150" h="90" /></stage><stage stageid="cc8eb38d-6d72-4953-9517-cdf9bfc04a1a" name="Start" type="Start"><subsheetid>4477334a-732f-4732-8c01-0bad20844fec</subsheetid><display x="15" y="-105" /><onsuccess>02d03bda-8484-4fc7-9e07-eb102dd0a98d</onsuccess></stage><stage stageid="b9cf30c7-26cd-4960-a4f3-bb919de8bc7c" name="End" type="End"><subsheetid>4477334a-732f-4732-8c01-0bad20844fec</subsheetid><display x="15" y="75" /></stage><stage stageid="fab03597-2cc5-437d-a16e-0ef6663a7451" name="Add to Work Queue" type="Action"><subsheetid>818c55a7-e531-41fa-9684-096150233871</subsheetid><loginhibit onsuccess="true" /><narrative>The Data collection contains the items to be added to the queue. The collection may contain single or multiple rows, with each representing an item to be added.

If there is a failure during the process, the queue will be unchanged - i.e. no rows will be loaded even if the error occurred on the last one.

If Defer Until is specified, the items will not be available to be worked until then. Otherwise, they are available immediately.

If the queue has a key field defined, an item added has key data longer than the maximum permitted 255 characters, an error will occur</narrative><display x="15" y="-15" /><inputs><input type="text" name="Queue Name" friendlyname="Queue Name" narrative="The name of the queue to add items to" expr="&quot;Purchases&quot;" /><input type="collection" name="Data" friendlyname="Data" narrative="A collection containing the data, one row for each item to be added" expr="[Advance Search Parameters Stage 1]" /><input type="datetime" name="Defer Until" friendlyname="Defer Until" narrative="Optionally, the date/time the new item(s) should be deferred until" expr="" /><input type="number" name="Priority" friendlyname="Priority" narrative="Optionally, the priority for the new item(s). Lower numbers represent higher priorities. The default is 0." expr="" /><input type="text" name="Tags" friendlyname="Tags" narrative="Optionally, a semi-colon-separated set of tags to apply to the queue item(s)" expr="" /><input type="text" name="Status" friendlyname="Status" narrative="Optionally, the initial status required of the work queue item(s) " expr="&quot;Pendiente&quot;" /><input type="number" name="Batch Size" friendlyname="Batch Size" narrative="Optionally, the batch size to use when adding many items to the queue.  A Value of 0 will process all items in one batch.  An empty field will use the default batch size of 1000." expr=""><validator type="BluePrism.AutomateProcessCore.RangeParameterValidation" parameter="0:25000" /></input><input type="timespan" name="SLA" friendlyname="SLA" narrative="Optionally, the SLA that specifies the agreed-upon response or resolution time for the item(s), indicating the maximum acceptable duration for processing them based on their criticality or urgency.&#xD;&#xA;SLA values are provided as a timespan with a minimum value of 1 second and a maximum value of 999 days, 23 hours, 59 minutes, and 59 seconds.&#xD;&#xA;There is no default value for SLA if one is not provided." expr="" /><input type="datetime" name="SLA Deadline" friendlyname="SLA Deadline" narrative="Optionally, the SLA Deadline specifies the agreed-upon response or resolution time for the item(s),&#xD;&#xA;indicating an explicitly set date for addressing them based on their criticality or urgency.&#xD;&#xA;SLA Deadline values are provided as a DateTime which must be less than 1000 days in the future.&#xD;&#xA;There is no default value for SLA Deadline if one is not provided. This value will override any&#xD;&#xA;value provided in the SLA input." expr="" /></inputs><outputs><output type="collection" name="Item IDs" friendlyname="Item IDs" narrative="The IDs of the items which have been added to the queue, in the order of the collection of data passed that was input" stage="" /></outputs><onsuccess>2f00c0c6-df54-4938-be35-87c8bf6221c0</onsuccess><resource object="Blueprism.Automate.clsWorkQueuesActions" action="Add To Queue" /></stage><stage stageid="3ea5984e-a488-474e-90dc-d299e8e0c4ad" name="Item ID" type="Data"><display x="-225" y="180" /><datatype>text</datatype><initialvalue /><alwaysinit /></stage><stage stageid="6d90f2db-24a8-460c-99ca-b6ea2ecfc9e0" name="Item data" type="Collection"><display x="-225" y="135" /><datatype>collection</datatype><alwaysinit /></stage><stage stageid="800dcaf8-c0ff-4e67-9650-e77d69b633d5" name="Item Status" type="Data"><display x="-165" y="180" /><datatype>text</datatype><initialvalue /><alwaysinit /></stage><stage stageid="03cae325-28c6-42dc-b6d5-2352453f1971" name="Item Attempts" type="Data"><display x="-165" y="135" /><datatype>number</datatype><initialvalue /><alwaysinit /></stage><stage stageid="23bafe4f-63e1-40e0-955f-1cac74e3055b" name="Work Queues" type="Block"><display x="-270" y="0" w="150" h="75" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="fc4f5415-7805-4054-add9-fbb2b1cf9d5e" name="Purchases" type="Data"><display x="-195" y="45" /><font family="Segoe UI" size="10" style="Bold" color="0000FF" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="af660793-164c-42ed-a06d-04329a203139" name="Puchases Data Items (Global Parameters)" type="Block"><display x="-270" y="90" w="150" h="120" /><font family="Segoe UI" size="10" style="Regular" color="00FFFF" /></stage><stage stageid="a9a3a45d-3df3-4390-b2ed-796721b89da6" name="File Name" type="Data"><display x="-225" y="315" /><datatype>text</datatype><initialvalue xml:space="preserve">Panama_Compras</initialvalue><alwaysinit /></stage><stage stageid="f94255ef-dba3-4973-a565-e2e872d0554d" name="File Path" type="Data"><loginhibit onsuccess="true" /><display x="-165" y="315" /><datatype>text</datatype><initialvalue xml:space="preserve">C:\Users\joser\OneDrive\Desktop\</initialvalue><alwaysinit /></stage><stage stageid="fbe4245e-ff8c-4894-af5a-df829fd7536c" name="Advance Search Parameters Stage 1" type="Collection"><display x="-225" y="360" /><datatype>collection</datatype><alwaysinit /></stage><stage stageid="bf52448c-2a0d-4b43-9e04-98d83ce4d648" name="General Variables of the process" type="Block"><display x="-270" y="225" w="150" h="165" /><font family="Segoe UI" size="10" style="Regular" color="99CC00" /></stage><stage stageid="f45d9210-3045-499b-94e0-b6db8f17b0bc" name="Advance Search Parameters Stage 2" type="Collection"><display x="-165" y="360" /><datatype>collection</datatype><private /><alwaysinit /></stage><stage stageid="f73fdc67-b033-426a-babc-4cb1f1c42a5b" name="Scrape Extra Information" type="Action"><subsheetid>cf716ed6-11dc-4ef0-8c38-562d4971f522</subsheetid><loginhibit onsuccess="true" /><display x="15" y="-45" /><inputs><input type="collection" name="Item data" friendlyname="Item data" expr="[Item data]" /></inputs><outputs><output type="collection" name="Complementary item data" friendlyname="Complementary item data" stage="Complementary item data" /></outputs><onsuccess>30d11c93-964e-4f35-b0da-efbd652a4ebe</onsuccess><resource object="BO_Web_PanamaPurchase" action="Scrape Extra Information" /></stage><stage stageid="1127b304-5263-4045-b83d-8af2580bf9d4" name="Extra item data" type="Collection"><subsheetid>cf716ed6-11dc-4ef0-8c38-562d4971f522</subsheetid><display x="-180" y="-45" w="90" h="60" /><datatype>collection</datatype><private /><alwaysinit /></stage><stage stageid="30d11c93-964e-4f35-b0da-efbd652a4ebe" name="Merge data" type="Action"><subsheetid>cf716ed6-11dc-4ef0-8c38-562d4971f522</subsheetid><loginhibit onsuccess="true" /><display x="15" y="15" /><inputs><input type="collection" name="Item data" friendlyname="Item data" expr="[Item data]" /><input type="collection" name="Complementary item data" friendlyname="Complementary item data" expr="[Complementary item data]" /></inputs><outputs><output type="collection" name="Item data completed" friendlyname="Item data completed" stage="Item data completed" /></outputs><onsuccess>639b494c-fb06-48bd-9741-7a03b3ce4e41</onsuccess><resource object="BO_Excel_Report" action="Merge data" /></stage><stage stageid="12980c66-ebea-4c71-be31-a585760b7a47" name="Go to item link" type="Action"><subsheetid>cf716ed6-11dc-4ef0-8c38-562d4971f522</subsheetid><loginhibit onsuccess="true" /><display x="15" y="-105" /><inputs><input type="collection" name="Item data" friendlyname="Item data" expr="[Item data]" /></inputs><onsuccess>f73fdc67-b033-426a-babc-4cb1f1c42a5b</onsuccess><resource object="BO_Web_PanamaPurchase" action="Go to item link" /></stage><stage stageid="d7f79aaf-51ad-4acd-840f-1632e10d4919" name="Complementary item data" type="Collection"><subsheetid>cf716ed6-11dc-4ef0-8c38-562d4971f522</subsheetid><display x="-180" y="30" w="90" h="60" /><datatype>collection</datatype><private /><alwaysinit /></stage><stage stageid="fa01a47d-5eea-488f-9091-9011d2a58199" name="Item data completed" type="Collection"><subsheetid>cf716ed6-11dc-4ef0-8c38-562d4971f522</subsheetid><display x="-180" y="105" w="90" h="60" /><datatype>collection</datatype><private /><alwaysinit /></stage><stage stageid="639b494c-fb06-48bd-9741-7a03b3ce4e41" name="Add extra data into Final Report" type="Action"><subsheetid>cf716ed6-11dc-4ef0-8c38-562d4971f522</subsheetid><loginhibit onsuccess="true" /><display x="15" y="75" /><inputs><input type="collection" name="Item data completed" friendlyname="Item data completed" expr="[Item data completed]" /></inputs><onsuccess>cf1b6f93-c799-4331-b395-a7c077ee3e99</onsuccess><resource object="BO_Excel_Report" action="Fill Report Stage 2" /></stage><stage stageid="43e1888d-8a1d-4178-a3b8-054958545a6b" name="Reset Consecutive Exception Indicators" type="MultipleCalculation"><subsheetid>fe712a0d-324d-4648-baa9-9b08b247de44</subsheetid><display x="15" y="75" /><onsuccess>a1c65acc-f763-449a-8cbb-0463b62d5da3</onsuccess><steps><calculation expression="&quot;&quot;" stage="Previous Exception Detail" /><calculation expression="0" stage="Consecutive Exception Count" /></steps></stage><stage stageid="e891b3f9-9b13-44ca-ad85-af39521fbf02" name="Update Status" type="Action"><subsheetid>fe712a0d-324d-4648-baa9-9b08b247de44</subsheetid><narrative>Updates the status field for the item. The status field can be used to flag what has been done in a process so far. If a process encounters an exception, this information can be used to skip to the parts of the process not yet done for the item next time it is worked. The item must be 'owned' by the calling process - i.e. it must have been retrieved using Get Next Item.

This action will also reset the Attempts column to zero, because if the status updated the process should have successfully done something.</narrative><display x="15" y="-45" /><inputs><input type="text" name="Item ID" narrative="The ID of the item to mark" expr="[Item ID]" /><input type="text" name="Status" narrative="The new status - 255 characters maximum." expr="&quot;Item Completed&quot;" /></inputs><onsuccess>851846e2-0d4b-4a95-bf54-972d267ecc92</onsuccess><resource object="Blueprism.Automate.clsWorkQueuesActions" action="Update Status" /></stage><stage stageid="851846e2-0d4b-4a95-bf54-972d267ecc92" name="Mark Completed" type="Action"><subsheetid>fe712a0d-324d-4648-baa9-9b08b247de44</subsheetid><narrative>Marks the item as completed, by updating the Completed timestamp and setting Locked to null. The item must be 'owned' by the calling process - i.e. it must have been retrieved using Get Next Item.</narrative><display x="15" y="15" /><inputs><input type="text" name="Item ID" narrative="The ID of the item to mark" expr="[Item ID]" /></inputs><onsuccess>43e1888d-8a1d-4178-a3b8-054958545a6b</onsuccess><resource object="Blueprism.Automate.clsWorkQueuesActions" action="Mark Completed" /></stage><stage stageid="8a24adc8-3b38-4872-86f0-610abf8b7e6c" name="Mark Item As Exception" type="SubSheetInfo"><subsheetid>b4d40402-d648-4d72-b23b-2ec7e5b24cac</subsheetid><narrative>Marks the current work queue item as an exception</narrative><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="d0e40bb3-697e-467a-b35e-b1f08d5a396e" name="Start" type="Start"><subsheetid>b4d40402-d648-4d72-b23b-2ec7e5b24cac</subsheetid><display x="-45" y="-150" /><onsuccess>127fe66c-c8eb-4458-8f17-a8cfe1537613</onsuccess></stage><stage stageid="f64ec6d9-26c5-4a56-bc12-fe250b2f2f0f" name="Previous Exception Detail" type="Data"><subsheetid>b4d40402-d648-4d72-b23b-2ec7e5b24cac</subsheetid><display x="-195" y="-30" /><datatype>text</datatype><initialvalue /></stage><stage stageid="f6954656-b289-4c43-beca-cfabab0a1b6d" name="Consecutive Exception Count" type="Data"><subsheetid>b4d40402-d648-4d72-b23b-2ec7e5b24cac</subsheetid><display x="-195" y="15" /><datatype>number</datatype><initialvalue>0</initialvalue></stage><stage stageid="fa5ea67f-5aca-4eff-9c27-94922a0e26ef" name="Consecutive Exception Limit" type="Data"><subsheetid>b4d40402-d648-4d72-b23b-2ec7e5b24cac</subsheetid><display x="-195" y="60" /><datatype>number</datatype><initialvalue>3</initialvalue><private /><alwaysinit /></stage><stage stageid="147240f7-b283-4747-891e-efd7ca42a945" name="Previous Exception?" type="Decision"><subsheetid>b4d40402-d648-4d72-b23b-2ec7e5b24cac</subsheetid><display x="-45" y="-30" /><decision expression="[Previous Exception Detail]=[Exception Detail]" /><ontrue>ba83c459-2944-41b9-b786-7bc32cfc1b40</ontrue><onfalse>2cade97b-24df-482a-95ed-5d988273ea90</onfalse></stage><stage stageid="ba83c459-2944-41b9-b786-7bc32cfc1b40" name="Count" type="Calculation"><subsheetid>b4d40402-d648-4d72-b23b-2ec7e5b24cac</subsheetid><display x="-45" y="30" /><onsuccess>1287d70a-d719-46bd-aca2-e00ae9de4203</onsuccess><calculation expression="1+ [Consecutive Exception Count]" stage="Consecutive Exception Count" /></stage><stage stageid="1287d70a-d719-46bd-aca2-e00ae9de4203" name="Limit exceeded?" type="Decision"><subsheetid>b4d40402-d648-4d72-b23b-2ec7e5b24cac</subsheetid><display x="-45" y="90" /><decision expression="[Consecutive Exception Count]&gt;=[Consecutive Exception Limit]" /><ontrue>81f6a7a7-3f08-4194-b74b-5e4d39e44ab6</ontrue><onfalse>d64a58e6-f87f-490b-8928-1335e1b31c56</onfalse></stage><stage stageid="f5d3f680-930b-48dd-9237-acb47b7860e1" name="Finish" type="Exception"><subsheetid>b4d40402-d648-4d72-b23b-2ec7e5b24cac</subsheetid><display x="165" y="180" w="120" h="30" /><font family="Segoe UI" size="12" style="Regular" color="000000" /><exception type="" detail="[Consecutive Exception Limit] &amp; &quot; consecutive incidents of &quot; &amp; [Exception Type] &amp; &quot;: &quot; &amp; [Exception Detail]" /></stage><stage stageid="d64a58e6-f87f-490b-8928-1335e1b31c56" name="End2" type="End"><subsheetid>b4d40402-d648-4d72-b23b-2ec7e5b24cac</subsheetid><display x="225" y="90" /></stage><stage stageid="fe09718d-578b-4bd4-8d57-4c6bce97c854" name="Reset exception variables" type="MultipleCalculation"><subsheetid>b4d40402-d648-4d72-b23b-2ec7e5b24cac</subsheetid><display x="225" y="-30" /><onsuccess>d64a58e6-f87f-490b-8928-1335e1b31c56</onsuccess><steps><calculation expression="[Exception Detail]" stage="Previous Exception Detail" /><calculation expression="0" stage="Consecutive Exception Count" /></steps></stage><stage stageid="81f6a7a7-3f08-4194-b74b-5e4d39e44ab6" name="Stop the process because consecutive exceptions are occuring" type="Note"><subsheetid>b4d40402-d648-4d72-b23b-2ec7e5b24cac</subsheetid><narrative>The consecutive exception limit has been reached, therefore, throw a new exception to end the process.
</narrative><display x="-45" y="180" w="120" h="60" /><onsuccess>f5d3f680-930b-48dd-9237-acb47b7860e1</onsuccess></stage><stage stageid="2cade97b-24df-482a-95ed-5d988273ea90" name="Note5" type="Note"><subsheetid>b4d40402-d648-4d72-b23b-2ec7e5b24cac</subsheetid><loginhibit /><narrative>This exception is different from the previous one.</narrative><display x="90" y="-30" w="120" h="30" /><onsuccess>fe09718d-578b-4bd4-8d57-4c6bce97c854</onsuccess></stage><stage stageid="127fe66c-c8eb-4458-8f17-a8cfe1537613" name="Mark item as an exception" type="Action"><subsheetid>b4d40402-d648-4d72-b23b-2ec7e5b24cac</subsheetid><loginhibit onsuccess="true" /><narrative>Marks the item as an exception, optionally retrying it by cloning the item and returning the ID of the clone. The item must be 'owned' by the calling process - i.e. it must have been retrieved using Get Next Item.</narrative><display x="-45" y="-90" /><inputs><input type="text" name="Item ID" narrative="The ID of the item to mark" expr="[Item ID]" /><input type="text" name="Exception Reason" narrative="A description of the reason for the exception" expr="[Exception Detail]" /><input type="flag" name="Retry" narrative="Whether or not to retry the item, up to the maximum number of attempts specified for the queue. Optional - if not specified, the item will be retried" expr="" /><input type="flag" name="Keep Locked" narrative="Whether or not the clone of the item should remain locked after the exception has been registered and the item is retried. Optional - default is False" expr="" /></inputs><outputs><output type="text" name="New Item ID" narrative="The Item ID of the newly cloned item. This item will be locked if 'Keep Locked' is True. This will be empty if no item was cloned (ie. the item was not retried." stage="" /></outputs><onsuccess>147240f7-b283-4747-891e-efd7ca42a945</onsuccess><resource object="Blueprism.Automate.clsWorkQueuesActions" action="Mark Exception" /></stage><stage stageid="69caddf4-0910-4dfd-abde-1515650875e3" name="Stop After Items" type="Data"><display x="-225" y="-45" /><datatype>number</datatype><initialvalue>50</initialvalue><private /><alwaysinit /></stage><stage stageid="15a04d74-8d6b-44af-be43-1b6a66e6f5ad" name="Exception Type" type="Data"><display x="-165" y="810" /><datatype>text</datatype><initialvalue /><alwaysinit /></stage><stage stageid="94316047-e950-418b-8ddc-4702cfcbaf13" name="Exception Detail" type="Data"><display x="-225" y="810" /><datatype>text</datatype><initialvalue /><alwaysinit /></stage><stage stageid="916d6889-38a9-4927-a231-42cb24cf482a" name="Stop After Time" type="Data"><loginhibit onsuccess="true" /><display x="-165" y="-45" /><datatype>time</datatype><initialvalue>23:30:00</initialvalue><alwaysinit /></stage><stage stageid="21a37955-3195-40d4-adc7-cd523be6cc8b" name="Variables to stop the process" type="Block"><display x="-270" y="-90" w="150" h="75" /><font family="Segoe UI" size="10" style="Regular" color="FF0000" /></stage><stage stageid="51a72742-8fa0-47be-917d-bb94c676794f" name="Exceptions Variables" type="Block"><display x="-270" y="765" w="150" h="75" /><font family="Segoe UI" size="10" style="Regular" color="FFCC00" /></stage><stage stageid="a25baaea-e1df-4d07-a3c5-0bfb312bbdc4" name="Reset Global Data Items" type="MultipleCalculation"><subsheetid>ed14d0af-54ba-4d3a-9ab2-ccf5a17c04e7</subsheetid><display x="15" y="-15" /><font family="Segoe UI" size="12" style="Regular" color="000000" /><onsuccess>60a4bfe2-d57d-4e9e-ad92-2ce39ed1039e</onsuccess><steps><calculation expression="&quot;&quot;" stage="Exception Detail" /><calculation expression="&quot;&quot;" stage="Exception Type" /></steps></stage><stage stageid="3054ed7b-8e63-4e9b-83db-8a931d3bf6fc" name="Get next item" type="Action"><narrative>This action gets the next item to be worked from the queue, returning its details and locking it so no other case can work it.

Items with higher priorities (lower numerical value) are processed first. Where the priority is the same, the next item is the one that has been in the queue the longest,  is not already locked, and is not already completed.

The Item ID returned is used to make further calls to update the work status for that item. It may be empty, in which case there are no items available. This can mean either a) the queue is empty, or b) the queue is not running. This mechanism can be used to cleanly stop all processes working a particular queue at the end of the next case. Items that have a 'deferred' time set will not be returned unless that time has been reached.</narrative><display x="300" y="120" /><inputs><input type="text" name="Queue Name" friendlyname="Queue Name" narrative="The name of the queue" expr="&quot;Purchases&quot;" /><input type="text" name="Key Filter" friendlyname="Key Filter" narrative="Optionally, a key value to filter by. Only items with this key value will be considered." expr="" /><input type="text" name="Tag Filter" friendlyname="Tag Filter" narrative="Optionally, a tag mask to filter by. This can consist of any number of tag searches - each term can be separated by a semi-colon and they are all applied to the search (ie. they are AND'ed terms not OR'ed terms). For example, &quot;Account: Joint; -Balance: Overdrawn; Card: *Visa*&quot; will include any items which match all the terms, ie. every item must have an 'Account: Joint' tag applied, no item can have a 'Balance: Overdrawn' tag applied, every item must have a tag applied which starts with 'Card: ' and then contains the text 'Visa'." expr="" /><input type="text" name="Sort Order" friendlyname="Sort Order" narrative="Sort order method (Priority, SLA, PriorityAndSLA)" lookupValue="Priority" lookupType="WorkQueueSortTypes" /></inputs><outputs><output type="text" name="Item ID" friendlyname="Item ID" narrative="The ID of the item retrieved - empty if there are none available." stage="Item ID" /><output type="collection" name="Data" friendlyname="Data" narrative="The data associated with the item - a single collection row." stage="Item data" /><output type="text" name="Status" friendlyname="Status" narrative="The status of the item." stage="Item Status" /><output type="number" name="Attempts" friendlyname="Attempts" narrative="The number of attempts already made to work this item." stage="Item Attempts" /></outputs><onsuccess>50f4dcf0-7ab2-44c3-9b1c-39e0a57d6890</onsuccess><resource object="Blueprism.Automate.clsWorkQueuesActions" action="Get Next Item" /></stage><stage stageid="7453ee65-e254-40d2-a753-aac3b08bbdde" name="Prepare the report and send it" type="SubSheetInfo"><subsheetid>76f21efb-d05c-4beb-ab4a-54cf55ecca57</subsheetid><display x="-180" y="-60" w="150" h="90" /></stage><stage stageid="56eefc57-8260-47d3-a0e6-6e1a2b688979" name="Start" type="Start"><subsheetid>76f21efb-d05c-4beb-ab4a-54cf55ecca57</subsheetid><display x="15" y="-105" /><onsuccess>78157e89-1661-447e-ae7e-fd905bbb224b</onsuccess></stage><stage stageid="29b3f870-8437-43d3-9ffc-2011c2543652" name="End" type="End"><subsheetid>76f21efb-d05c-4beb-ab4a-54cf55ecca57</subsheetid><display x="15" y="75" /></stage><stage stageid="78157e89-1661-447e-ae7e-fd905bbb224b" name="Apply latest filters" type="Action"><subsheetid>76f21efb-d05c-4beb-ab4a-54cf55ecca57</subsheetid><loginhibit onsuccess="true" /><display x="15" y="-45" /><inputs><input type="text" name="File Path" friendlyname="File Path" expr="[File Path]" /><input type="text" name="File Name" friendlyname="File Name" expr="[File Name]" /></inputs><onsuccess>04b81606-e2ea-49a3-a2ec-a27515201438</onsuccess><resource object="BO_Excel_Report" action="Apply latest filters" /></stage><stage stageid="04b81606-e2ea-49a3-a2ec-a27515201438" name="Send Report" type="Action"><subsheetid>76f21efb-d05c-4beb-ab4a-54cf55ecca57</subsheetid><loginhibit onsuccess="true" /><display x="15" y="15" /><inputs><input type="text" name="Email user" friendlyname="Email user" expr="[Email user]" /><input type="password" name="Email pass" friendlyname="Email pass" expr="[Email pass]" /><input type="text" name="Attachment" friendlyname="Attachment" expr="[File Path] &amp; [File Name] &amp; &qu