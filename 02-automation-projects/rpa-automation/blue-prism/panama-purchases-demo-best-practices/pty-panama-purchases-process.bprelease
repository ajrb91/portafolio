etid>fdd9b69c-5523-46ca-8032-4edaeedc62eb</subsheetid><loginhibit onsuccess="true" /><display x="30" y="-30" /><inputs><input type="number" name="handle" friendlyname="handle" narrative="The integer handle identifying the instance on which the required workbook should be opened. The default of zero indicates the currently active instance." expr="[handle]" /><input type="text" name="File name" friendlyname="File name" narrative="The path and name of the file which should be opened." expr="[File Path] &amp; [File Name] &amp; &quot;.xlsx&quot;" /></inputs><outputs><output type="text" name="Workbook Name" friendlyname="Workbook Name" narrative="The name used by Excel to identify the workbook - usually this is the file name (without the path)." stage="" /></outputs><onsuccess>c4131198-57ef-4588-a387-dab0891ff382</onsuccess><resource object="MS Excel VBO" action="Open Workbook" /></stage><stage stageid="b258f04b-4ec6-42c6-92ae-2a64608b20a9" name="handle" type="Data"><subsheetid>fdd9b69c-5523-46ca-8032-4edaeedc62eb</subsheetid><display x="-195" y="-30" /><datatype>number</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="41d88bfa-0e3d-4485-8a38-8dbd30369aa9" name="File Name" type="Data"><subsheetid>fdd9b69c-5523-46ca-8032-4edaeedc62eb</subsheetid><display x="-195" y="15" /><datatype>text</datatype><initialvalue xml:space="preserve">Panama_Compras</initialvalue><private /><alwaysinit /></stage><stage stageid="b7a39df5-88cf-4ae8-ae92-3c5679c73015" name="File Path" type="Data"><subsheetid>fdd9b69c-5523-46ca-8032-4edaeedc62eb</subsheetid><loginhibit onsuccess="true" /><display x="-195" y="60" /><datatype>text</datatype><initialvalue xml:space="preserve">C:\Users\joser\OneDrive\Desktop\</initialvalue><private /><alwaysinit /></stage><stage stageid="98d41098-fbb0-49e9-8dac-9eb6929c4b65" name="Item data completed" type="Collection"><subsheetid>fdd9b69c-5523-46ca-8032-4edaeedc62eb</subsheetid><display x="-195" y="105" /><datatype>collection</datatype><private /><alwaysinit /></stage><stage stageid="654c2e0c-d245-499a-9688-5a2cf6cdc3b6" name="Set Cell Value Precio Referencia" type="Action"><subsheetid>fdd9b69c-5523-46ca-8032-4edaeedc62eb</subsheetid><loginhibit onsuccess="true" /><display x="30" y="270" /><inputs><input type="number" name="handle" friendlyname="handle" narrative="The integer handle identifying the instance on which the required cell value should be set. The default of zero indicates the currently active instance." expr="[handle]" /><input type="text" name="Cell Reference" friendlyname="Cell Reference" narrative="The reference on the speficied sheet identifying the cell which should be set." expr="Replace([Cell Address], &quot;A&quot;, &quot;E&quot;)" /><input type="text" name="Value" friendlyname="Value" narrative="The value to which the specified cell should be set." expr="[Item data completed.Precio Referencia]" /></inputs><onsuccess>e4a565a6-8c2a-4a09-964a-338dc7a59633</onsuccess><resource object="MS Excel VBO" action="Set Cell Value" /></stage><stage stageid="e4a565a6-8c2a-4a09-964a-338dc7a59633" name="Set Cell Value Fecha Hora Presentacion" type="Action"><subsheetid>fdd9b69c-5523-46ca-8032-4edaeedc62eb</subsheetid><loginhibit onsuccess="true" /><display x="30" y="330" /><inputs><input type="number" name="handle" friendlyname="handle" narrative="The integer handle identifying the instance on which the required cell value should be set. The default of zero indicates the currently active instance." expr="[handle]" /><input type="text" name="Cell Reference" friendlyname="Cell Reference" narrative="The reference on the speficied sheet identifying the cell which should be set." expr="Replace([Cell Address], &quot;A&quot;, &quot;F&quot;)" /><input type="text" name="Value" friendlyname="Value" narrative="The value to which the specified cell should be set." expr="[Item data completed.Fecha Hora Presentacion]" /></inputs><onsuccess>6d69b770-ef8d-4828-a63c-e2bd2b2518eb</onsuccess><resource object="MS Excel VBO" action="Set Cell Value" /></stage><stage stageid="c4131198-57ef-4588-a387-dab0891ff382" name="Show Instance" type="Action"><subsheetid>fdd9b69c-5523-46ca-8032-4edaeedc62eb</subsheetid><loginhibit onsuccess="true" /><display x="30" y="30" /><inputs><input type="number" name="handle" friendlyname="handle" narrative="The integer handle identifying the instance which should have its window displayed. The default of zero indicates the currently active instance." expr="[handle]" /></inputs><onsuccess>aae55c3c-8d4b-4d43-9f27-f31d1947ac87</onsuccess><resource object="MS Excel VBO" action="Show" /></stage><stage stageid="aae55c3c-8d4b-4d43-9f27-f31d1947ac87" name="Find Cell Reference" type="Code"><subsheetid>fdd9b69c-5523-46ca-8032-4edaeedc62eb</subsheetid><loginhibit /><display x="30" y="90" /><inputs><input type="text" name="filePath" expr="[File Path] &amp; [File Name] &amp; &quot;.xlsx&quot;" /><input type="text" name="numero" expr="[Item data completed.Número]" /></inputs><outputs><output type="text" name="cellAddress" stage="Cell Address" /><output type="flag" name="found" stage="Cell Found" /><output type="text" name="message" stage="Code 1 Output Message" /></outputs><onsuccess>eef93ee1-025d-400f-885a-2563dfe36653</onsuccess><code><![CDATA[Dim connStr As String = ""
Dim conn As Object = Nothing
Dim da As Object = Nothing
Dim dt As Object = Nothing

cellAddress = ""
found = False
message = ""

Try

    If filePath = "" Then
        message = "filePath vacío"
        Exit Sub
    End If

    If numero = "" Then
        message = "numero vacío"
        Exit Sub
    End If

    connStr = "Provider=Microsoft.ACE.OLEDB.12.0;Data Source=" & filePath & ";Extended Properties=""Excel 12.0 Xml;HDR=YES;IMEX=1"";"

    conn = CreateObject("ADODB.Connection")
    conn.Open(connStr)

    Dim rs As Object
    rs = CreateObject("ADODB.Recordset")

    ' Cambia Hoja1$ si tu hoja tiene otro nombre
    rs.Open("SELECT [Número] FROM [Hoja1$]", conn)

    Dim rowIndex As Integer = 2 ' empieza en fila 2 (fila 1 header)

    Do Until rs.EOF

        Dim val As String
        val = ""

        If Not IsDBNull(rs.Fields(0).Value) Then
            val = Trim(CStr(rs.Fields(0).Value))
        End If

        If val = Trim(numero) Then
            cellAddress = "A" & CStr(rowIndex)
            found = True
            message = "OK"
            Exit Do
        End If

        rowIndex = rowIndex + 1
        rs.MoveNext

    Loop

    If Not found Then
        message = "No encontrado"
    End If

    rs.Close
    conn.Close

Catch ex As Exception
    message = ex.Message
End Try]]></code></stage><stage stageid="9e7d0e9b-2e1a-4c67-9537-3827c573daad" name="Cell Address" type="Data"><subsheetid>fdd9b69c-5523-46ca-8032-4edaeedc62eb</subsheetid><display x="-195" y="195" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="67c6d4c5-224c-4d82-8f10-c25ae0457fec" name="Cell Found" type="Data"><subsheetid>fdd9b69c-5523-46ca-8032-4edaeedc62eb</subsheetid><display x="-195" y="150" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="6cceb1b7-4e12-431f-a396-7647e957df95" name="Code 1 Output Message" type="Data"><subsheetid>fdd9b69c-5523-46ca-8032-4edaeedc62eb</subsheetid><display x="-195" y="240" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="f3e135ca-be4e-483e-bc6c-b22c68562c6c" name="Agregar Encabezado 2" type="Action"><subsheetid>fdd9b69c-5523-46ca-8032-4edaeedc62eb</subsheetid><loginhibit onsuccess="true" /><display x="30" y="210" /><inputs><input type="number" name="handle" friendlyname="handle" narrative="The integer handle identifying the instance on which the required cell value should be set. The default of zero indicates the currently active instance." expr="[handle]" /><input type="text" name="Cell Reference" friendlyname="Cell Reference" narrative="The reference on the speficied sheet identifying the cell which should be set." expr="&quot;F1&quot;" /><input type="text" name="Value" friendlyname="Value" narrative="The value to which the specified cell should be set." expr="&quot;Fecha Hora Presentacion&quot;" /></inputs><onsuccess>654c2e0c-d245-499a-9688-5a2cf6cdc3b6</onsuccess><resource object="MS Excel VBO" action="Set Cell Value" /></stage><stage stageid="eef93ee1-025d-400f-885a-2563dfe36653" name="Agregar Encabezado 1" type="Action"><subsheetid>fdd9b69c-5523-46ca-8032-4edaeedc62eb</subsheetid><loginhibit onsuccess="true" /><display x="30" y="150" /><inputs><input type="number" name="handle" friendlyname="handle" narrative="The integer handle identifying the instance on which the required cell value should be set. The default of zero indicates the currently active instance." expr="[handle]" /><input type="text" name="Cell Reference" friendlyname="Cell Reference" narrative="The reference on the speficied sheet identifying the cell which should be set." expr="&quot;E1&quot;" /><input type="text" name="Value" friendlyname="Value" narrative="The value to which the specified cell should be set." expr="&quot;Precio Referencia&quot;" /></inputs><onsuccess>f3e135ca-be4e-483e-bc6c-b22c68562c6c</onsuccess><resource object="MS Excel VBO" action="Set Cell Value" /></stage><stage stageid="1e350230-d42b-4198-9964-0d338f1b4406" name="Apply latest filters" type="SubSheetInfo"><subsheetid>ce73c1c5-d3fc-4547-bf73-f9ea0109e25d</subsheetid><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="df7a94a2-7bfc-4738-a8fe-d95adee52990" name="Start" type="Start"><subsheetid>ce73c1c5-d3fc-4547-bf73-f9ea0109e25d</subsheetid><loginhibit /><display x="15" y="-105" /><inputs><input type="text" name="File Path" stage="File Path" /><input type="text" name="File Name" stage="File Name" /></inputs><onsuccess>c443a201-17aa-4a86-9b83-5b0ca02393c5</onsuccess></stage><stage stageid="cfad363c-17fd-40f6-8ed6-d320d972f817" name="End" type="End"><subsheetid>ce73c1c5-d3fc-4547-bf73-f9ea0109e25d</subsheetid><loginhibit /><display x="15" y="15" /></stage><stage stageid="c443a201-17aa-4a86-9b83-5b0ca02393c5" name="Apply latest filters" type="Code"><subsheetid>ce73c1c5-d3fc-4547-bf73-f9ea0109e25d</subsheetid><loginhibit /><display x="15" y="-45" /><inputs><input type="text" name="filePath" expr="[File Path] &amp; [File Name] &amp; &quot;.xlsx&quot;" /><input type="text" name="outputFilePath" expr="[File Path] &amp; [File Name] &amp; &quot;.xlsx&quot;" /><input type="text" name="sheetName" expr="&quot;Hoja1&quot;" /></inputs><outputs><output type="flag" name="success" stage="Success" /><output type="text" name="message" stage="Message" /><output type="text" name="savedFilePath" stage="Saved File Path" /></outputs><onsuccess>cfad363c-17fd-40f6-8ed6-d320d972f817</onsuccess><code><![CDATA[' ============================
' Blue Prism Code Stage (VB.NET)
' Parte 3: Sort + Formatos
'
' Inputs:
'   filePath As String
'   outputFilePath As String
'   sheetName As String   ' opcional (si vacío usa la primera hoja)
'
' Outputs:
'   success As Boolean
'   message As String
'   savedFilePath As String
' ============================

success = False
message = ""
savedFilePath = ""

Dim xlApp As Object = Nothing
Dim wb As Object = Nothing
Dim ws As Object = Nothing

Try

    If String.IsNullOrWhiteSpace(filePath) Then
        message = "filePath vacío."
        Exit Try
    End If

    If String.IsNullOrWhiteSpace(outputFilePath) Then
        message = "outputFilePath vacío."
        Exit Try
    End If

    xlApp = CreateObject("Excel.Application")
    xlApp.DisplayAlerts = False
    xlApp.Visible = False

    wb = xlApp.Workbooks.Open(filePath)

    If String.IsNullOrWhiteSpace(sheetName) Then
        ws = wb.Worksheets(1)
    Else
        ws = wb.Worksheets(sheetName)
    End If

    Dim usedRange As Object = ws.UsedRange
    Dim lastRow As Integer = usedRange.Rows.Count
    Dim lastCol As Integer = usedRange.Columns.Count

    If lastRow < 2 Then
        message = "No hay datos."
        Exit Try
    End If

    ' --- Encontrar columnas por header (fila 1) ---
    ' Fecha: "Fecha Hora Presentacion" (equiv "Fecha de Propuesta")
    ' Monto: "Precio Referencia" (equiv "Monto")
    Dim colFecha As Integer = -1
    Dim colMonto As Integer = -1

    Dim c As Integer
    For c = 1 To lastCol
        Dim hv As Object = ws.Cells(1, c).Value
        Dim h As String = ""
        If hv IsNot Nothing Then
            h = Trim(CStr(hv))
        End If

        If String.Equals(h, "Fecha Hora Presentacion", StringComparison.OrdinalIgnoreCase) _
           OrElse String.Equals(h, "Fecha de Propuesta", StringComparison.OrdinalIgnoreCase) Then
            colFecha = c
        End If

        If String.Equals(h, "Precio Referencia", StringComparison.OrdinalIgnoreCase) _
           OrElse String.Equals(h, "Monto", StringComparison.OrdinalIgnoreCase) Then
            colMonto = c
        End If
    Next

    If colFecha = -1 Then
        message = "No se encontró la columna de fecha (Fecha Hora Presentacion / Fecha de Propuesta)."
        Exit Try
    End If

    If colMonto = -1 Then
        message = "No se encontró la columna de monto (Precio Referencia / Monto)."
        Exit Try
    End If

    ' --- Columnas auxiliares (al final) ---
    Dim colDateSort As Integer = lastCol + 1
    Dim colMontoSort As Integer = lastCol + 2

    ws.Cells(1, colDateSort).Value = "ZZ_DateSort"
    ws.Cells(1, colMontoSort).Value = "ZZ_MontoSort"

    Dim thresholdDate As Date = DateAdd(DateInterval.Month, -3, Date.Now)

    ' Culture invariants para parse robusto
    Dim inv As System.Globalization.CultureInfo = System.Globalization.CultureInfo.InvariantCulture
    Dim styles As System.Globalization.NumberStyles = System.Globalization.NumberStyles.Any

    Dim r As Integer
    For r = 2 To lastRow

        ' ======================
        ' FECHA (parse robusto)
        ' ======================
        Dim fv As Object = ws.Cells(r, colFecha).Value
        Dim rawFecha As String = ""
        If fv IsNot Nothing Then
            rawFecha = Trim(CStr(fv))
        End If

        Dim parsedFechaOk As Boolean = False
        Dim parsedFecha As Date

        ' Caso Excel serial
        If fv IsNot Nothing AndAlso IsNumeric(fv) Then
            parsedFecha = DateTime.FromOADate(CDbl(fv))
            parsedFechaOk = True

        ElseIf rawFecha.Length >= 10 Then
            ' En tu archivo: "10-02-2026 hasta 11:00 AM" -> tomamos "10-02-2026"
            Dim s10 As String = rawFecha.Substring(0, 10)

            If DateTime.TryParse(s10, parsedFecha) Then
                parsedFechaOk = True
            Else
                Dim sAlt As String = s10.Replace("-", "/")
                If DateTime.TryParse(sAlt, parsedFecha) Then
                    parsedFechaOk = True
                End If
            End If
        End If

        If parsedFechaOk Then
            ws.Cells(r, colDateSort).Value = parsedFecha
            ' Verde si está dentro de los últimos 3 meses
            If parsedFecha >= thresholdDate Then
                ws.Cells(r, colFecha).Interior.Color = RGB(0, 176, 80)
            End If
        Else
            ws.Cells(r, colDateSort).Value = ""
        End If

        ' ======================
        ' MONTO (parse robusto)
        ' ======================
        Dim mv As Object = ws.Cells(r, colMonto).Value
        Dim rawMonto As String = ""
        If mv IsNot Nothing Then
            rawMonto = Trim(CStr(mv))
        End If

        Dim parsedMontoOk As Boolean = False
        Dim parsedMonto As Double = 0

        If mv IsNot Nothing AndAlso IsNumeric(mv) Then
            parsedMonto = CDbl(mv)
            parsedMontoOk = True
        Else
            Dim ms As String = rawMonto
            ms = ms.Replace("B/.", "").Replace("B/", "").Replace("$", "")
            ms = ms.Replace(" ", "").Trim()

            ' Caso típico Panamá: "15,030.00" (miles=',' decimal='.')
            ' Quitamos separador de miles y parseamos con InvariantCulture
            If ms.Contains(",") AndAlso ms.Contains(".") Then
                ms = ms.Replace(",", "")
            End If

            If Double.TryParse(ms, styles, inv, parsedMonto) Then
                parsedMontoOk = True
            End If
        End If

        If parsedMontoOk Then
            ws.Cells(r, colMontoSort).Value = parsedMonto

            ' Amarillo + negrita si > 50,000
            If parsedMonto > 50000.0 Then
                ws.Cells(r, colMonto).Font.Bold = True
                ws.Cells(r, colMonto).Interior.Color = RGB(255, 255, 0)
            End If
        Else
            ws.Cells(r, colMontoSort).Value = ""
        End If

    Next

    ' --- SORT (Range.Sort) - más compatible con late binding ---
    Dim sortRange As Object = ws.Range(ws.Cells(1, 1), ws.Cells(lastRow, colMontoSort))
    Dim key1 As Object = ws.Range(ws.Cells(2, colDateSort), ws.Cells(lastRow, colDateSort))
    Dim key2 As Object = ws.Range(ws.Cells(2, colMontoSort), ws.Cells(lastRow, colMontoSort))

    ' Header=1 (xlYes), Order1=2 (xlDescending), Order2=2 (xlDescending), Orientation=1 (xlTopToBottom)
    sortRange.Sort(key1, 2, key2, , 2, , , 1)

    ' Ocultar auxiliares (ambas)
    ws.Columns(colDateSort).Hidden = True
    ws.Columns(colMontoSort).Hidden = True

    ' Guardar como XLSX (51)
    wb.SaveAs(outputFilePath, 51)
    savedFilePath = outputFilePath

    success = True
    message = "OK"

Catch ex As Exception
    success = False
    message = "Error: " & ex.Message

Finally
    Try
        If wb IsNot Nothing Then
            wb.Close(False)
        End If
    Catch
    End Try

    Try
        If xlApp IsNot Nothing Then
            xlApp.Quit()
        End If
    Catch
    End Try

    wb = Nothing
    ws = Nothing
    xlApp = Nothing

    GC.Collect()
    GC.WaitForPendingFinalizers()
    GC.Collect()
    GC.WaitForPendingFinalizers()
End Try]]></code></stage><stage stageid="641bcdef-b44c-4ccd-a954-4bbe248f6e43" name="File Name" type="Data"><subsheetid>ce73c1c5-d3fc-4547-bf73-f9ea0109e25d</subsheetid><display x="-195" y="15" /><datatype>text</datatype><initialvalue xml:space="preserve">Panama_Compras</initialvalue><private /><alwaysinit /></stage><stage stageid="3fcebed8-8b14-4475-87ca-082abe4c8d6f" name="Success" type="Data"><subsheetid>ce73c1c5-d3fc-4547-bf73-f9ea0109e25d</subsheetid><display x="-195" y="105" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="92647ad3-1a02-4967-a090-d37a976682d9" name="Message" type="Data"><subsheetid>ce73c1c5-d3fc-4547-bf73-f9ea0109e25d</subsheetid><display x="-195" y="60" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="a3f79a95-d24f-424a-a6de-df45190859a4" name="Saved File Path" type="Data"><subsheetid>ce73c1c5-d3fc-4547-bf73-f9ea0109e25d</subsheetid><display x="-195" y="150" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="48ac1646-b5fc-4968-93aa-f90f22d029d0" name="File Path" type="Data"><subsheetid>ce73c1c5-d3fc-4547-bf73-f9ea0109e25d</subsheetid><loginhibit onsuccess="true" /><display x="-195" y="-30" /><datatype>text</datatype><initialvalue xml:space="preserve">C:\Users\joser\OneDrive\Desktop\</initialvalue><private /><alwaysinit /></stage></process></object>
        <object id="cca2a3a5-7988-4dc1-969f-0db14e7774a9" name="BO_Mail" xmlns="http://www.blueprism.co.uk/product/process"><process name="BO_Mail" version="1.0" bpversion="7.4.1.15931" narrative="Read email / send email" byrefcollection="true" processrunningmessage="" disableversioning="false" type="object" runmode="Exclusive"><appdef><element name="Application Root"><id>61345097-6ac6-432e-bc18-1187fbe3cf1d</id><type>Application</type><basetype>Application</basetype><datatype>unknown</datatype><diagnose>False</diagnose></element></appdef><view><camerax>0</camerax><cameray>0</cameray><zoom version="2">1.25</zoom></view><preconditions /><endpoint narrative="" /><subsheet subsheetid="de2badf2-8979-42f1-908d-04ba5f4511fe" type="CleanUp" published="True"><name>Clean Up</name><view><camerax>0</camerax><cameray>0</cameray><zoom version="2">1.25</zoom></view></subsheet><subsheet subsheetid="b59372e6-5a14-4fe6-97f2-150509c24afc" type="Normal" published="True"><name>Send Report</name><view><camerax>-147</camerax><cameray>21</cameray><zoom version="2">1.25</zoom></view></subsheet><subsheet subsheetid="b7a856b9-8bdf-409e-a6e3-f39b15b62dbe" type="Normal" published="True"><name>Inbox Monitor</name><view><camerax>-91</camerax><cameray>105</cameray><zoom version="2">1.25</zoom></view></subsheet><stage stageid="e9d94fbe-015c-4bb6-8111-e42d81806ca8" name="Start" type="Start"><loginhibit /><display x="15" y="-105" /><onsuccess>8e884afe-488d-45ca-b9c1-658865ebaae1</onsuccess></stage><stage stageid="8e884afe-488d-45ca-b9c1-658865ebaae1" name="End" type="End"><loginhibit /><display x="15" y="90" /></stage><stage stageid="49cf1355-ca1a-47f4-a246-15b4c8b4c3a1" name="Stage1" type="ProcessInfo"><display x="-195" y="-105" w="150" h="90" /><references><reference>System.dll</reference><reference>System.Data.dll</reference><reference>System.Xml.dll</reference><reference>System.Drawing.dll</reference><reference>MailKit.dll</reference><reference>MimeKit.dll</reference><reference>System.IO.dll</reference></references><imports><import>System</import><import>System.Drawing</import><import>System.Data</import></imports><language>visualbasic</language><pythondllpath></pythondllpath><pythonenvpath></pythonenvpath><globalcode><![CDATA[]]></globalcode><code><![CDATA[]]></code></stage><stage stageid="d79ece0b-ea77-4b10-8a82-3c8305bcf891" name="Clean Up" type="SubSheetInfo"><subsheetid>de2badf2-8979-42f1-908d-04ba5f4511fe</subsheetid><display x="-195" y="-105" w="150" h="90" /></stage><stage stageid="7ffe5a76-310f-4818-995d-2a4a93d7ed9f" name="Start" type="Start"><subsheetid>de2badf2-8979-42f1-908d-04ba5f4511fe</subsheetid><loginhibit /><display x="15" y="-105" /><onsuccess>77401f71-5130-49ff-9a3f-b3507c7b2318</onsuccess></stage><stage stageid="77401f71-5130-49ff-9a3f-b3507c7b2318" name="End" type="End"><subsheetid>de2badf2-8979-42f1-908d-04ba5f4511fe</subsheetid><loginhibit /><display x="15" y="90" /></stage><stage stageid="ed4d26c3-8919-4fd9-87cd-d67cf870ff47" name="Send Report" type="SubSheetInfo"><subsheetid>b59372e6-5a14-4fe6-97f2-150509c24afc</subsheetid><display x="-195" y="-90" w="150" h="90" /></stage><stage stageid="a2ea64e5-fc27-429f-9e59-2dac2ef40954" name="Start" type="Start"><subsheetid>b59372e6-5a14-4fe6-97f2-150509c24afc</subsheetid><loginhibit /><display x="15" y="-105" /><inputs><input type="text" name="Email user" stage="Email user" /><input type="password" name="Email pass" stage="Email pass" /><input type="text" name="From" stage="From" /><input type="text" name="To" stage="To" /><input type="text" name="Subject" stage="Subject" /><input type="text" name="Body" stage="Body" /><input type="text" name="Attachment" stage="Attachments.Path" /></inputs><onsuccess>748927f4-c47d-4aa0-84fe-cc1c451c2463</onsuccess></stage><stage stageid="e73f9dee-227a-493f-a07f-8e7cc5af7a90" name="End" type="End"><subsheetid>b59372e6-5a14-4fe6-97f2-150509c24afc</subsheetid><loginhibit /><display x="15" y="75" /></stage><stage stageid="e0cdbde6-e1dd-4e03-a808-cb468eed93dc" name="Clean Up" type="Note"><subsheetid>de2badf2-8979-42f1-908d-04ba5f4511fe</subsheetid><narrative>Clean Up Page

This is an optional page where you might choose to perform some finalisation (or "cleanup") tasks as your business object is closed down.

The cleanup action will be called automatically immediately after closing your business object at the end of a business process.

You will not be able to call this action from a business process, nor will it be called at any other time than before the disposal of the business object.</narrative><display x="-180" y="60" w="180" h="230" /></stage><stage stageid="006c5fa0-e42d-45f4-b3c4-bfd8c389b968" name="Initialise" type="Note"><narrative>Initialise Page

This is an optional page where you might choose to perform some initialisation tasks after your business object is loaded.

The initialise action will be called automatically immediately after loading your business object.

You will not be able to call this action from a business process, nor will it be called at any other time than after the creation of the object.</narrative><display x="-180" y="60" w="180" h="230" /></stage><stage stageid="748927f4-c47d-4aa0-84fe-cc1c451c2463" name="Email Configure" type="Action"><subsheetid>b59372e6-5a14-4fe6-97f2-150509c24afc</subsheetid><loginhibit onsuccess="true" /><display x="15" y="-45" /><inputs><input type="text" name="Username" friendlyname="Username" narrative="The POP3 and SMTP Username" expr="[Email user]" /><input type="password" name="Password" friendlyname="Password" narrative="The POP3 and SMTP Password" expr="[Email pass]" /><input type="text" name="POP3 Server" friendlyname="POP3 Server" narrative="The POP3 Server address e.g. pop.domain.com" expr="" /><input type="number" name="POP3 Port" friendlyname="POP3 Port" narrative="The POP3 Port, e.g. 110 or 995" expr="" /><input type="flag" name="POP3 UseSSL" friendlyname="POP3 UseSSL" narrative="Whether to use SSL for POP3" expr="" /><input type="text" name="SMTP Server" friendlyname="SMTP Server" narrative="The SMTP Server address e.g. smtp.domain.com" expr="[Server]" /><input type="number" name="SMTP Port" friendlyname="SMTP Port" narrative="The SMTP Port, e.g 25 or 465" expr="[SMTP Port]" /><input type="flag" name="SMTP UseSSL" friendlyname="SMTP UseSSL" narrative="Whether to use SSL for SMTP" expr="False" /><input type="flag" name="Use OAuth2" friendlyname="Use OAuth2" narrative="Optional: Flag that indicates OAuth2 authentication should be used when connecting to the POP3 server." expr="False" /><input type="text" name="OAuth2 Access Token" friendlyname="OAuth2 Access Token" narrative="Optional: A valid, non-expired OAuth2 access token for the target platform (ex. Exchange Online, Google Mail, etc). Note: Use of OAuth only applies to POP3. SMTP AUTH is still used for SMTP connections." expr="" /><input type="text" name="IMAP Server" friendlyname="IMAP Server" narrative="The IMAP Server. Supplied by your IT dept or ISP" expr="" /><input type="number" name="IMAP Port" friendlyname="IMAP Port" narrative="The IMAP Port 993 or in some cases 143" expr="" /><input type="flag" name="UseStartTLS" friendlyname="UseStartTLS" narrative="Use StartTLS for IMAP Server" expr="True" /></inputs><onsuccess>7b89474d-315f-437d-a97b-2417dd4d03f0</onsuccess><resource object="Email - POP3/SMTP/IMAP" action="Configure" /></stage><stage stageid="7b89474d-315f-437d-a97b-2417dd4d03f0" name="Send Message" type="Action"><subsheetid>b59372e6-5a14-4fe6-97f2-150509c24afc</subsheetid><loginhibit onsuccess="true" /><display x="15" y="15" /><inputs><input type="text" name="From" friendlyname="From" narrative="The email address of the sender." expr="[From]" /><input type="text" name="To" friendlyname="To" narrative="The email address of the recipient. To address multiple recipients use the format &quot;john.smith@example.com, henry.jones@example.com&quot; OR &quot;John Smith &lt;john.smith@example.com&gt;, Henry Jones &lt;henry.jones@example.com&gt;&quot;." expr="[To]" /><input type="text" name="CC" friendlyname="CC" narrative="The email address of the recipient in CC. To address multiple recipients use the format &quot;john.smith@example.com, henry.jones@example.com&quot; OR &quot;John Smith &lt;john.smith@example.com&gt;, Henry Jones &lt;henry.jones@example.com&gt;&quot;." expr="" /><input type="text" name="BCC" friendlyname="BCC" narrative="The email address of the recipient in BCC. To address multiple recipients use the format &quot;john.smith@example.com, henry.jones@example.com&quot; OR &quot;John Smith &lt;john.smith@example.com&gt;, Henry Jones &lt;henry.jones@example.com&gt;&quot;." expr="" /><input type="text" name="Subject" friendlyname="Subject" narrative="The subject of the email." expr="[Subject]" /><input type="text" name="Body" friendlyname="Body" narrative="The body of the email." expr="[Body]" /><input type="collection" name="Attachments" friendlyname="Attachments" narrative="A Collection containing a list of files to add to the email as attachments." expr="[Attachments]" /><input type="flag" name="BodyIsHTML" friendlyname="BodyIsHTML" narrative="Indicates if the body should be sent as HTML" expr="" /></inputs><onsuccess>e73f9dee-227a-493f-a07f-8e7cc5af7a90</onsuccess><resource object="Email - POP3/SMTP/IMAP" action="Send Message" /></stage><stage stageid="e9318636-8c61-4a30-8613-92763214e8ad" name="Email user" type="Data"><subsheetid>b59372e6-5a14-4fe6-97f2-150509c24afc</subsheetid><loginhibit /><display x="-240" y="-15" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="a92727e3-cb0a-4cf4-9e87-203ec77b6d55" name="Email pass" type="Data"><subsheetid>b59372e6-5a14-4fe6-97f2-150509c24afc</subsheetid><loginhibit /><display x="-240" y="30" /><datatype>password</datatype><initialvalueenc></initialvalueenc><private /><alwaysinit /></stage><stage stageid="4df8f573-6ea7-451d-860f-a868e816cd77" name="Inbox Monitor" type="SubSheetInfo"><subsheetid>b7a856b9-8bdf-409e-a6e3-f39b15b62dbe</subsheetid><display x="-210" y="-105" w="150" h="90" /></stage><stage stageid="06fb0f1c-ae63-4418-856f-7e1afb661c6d" name="Start" type="Start"><subsheetid>b7a856b9-8bdf-409e-a6e3-f39b15b62dbe</subsheetid><loginhibit /><display x="15" y="-105" /><inputs><input type="text" name="Server" stage="Server" /><input type="number" name="IMAP Port" stage="IMAP Port" /><input type="text" name="Email user" stage="Email user" /><input type="password" name="Email pass" stage="Email pass" /><input type="text" name="Subject To Match" stage="Subject To Match" /><input type="number" name="Time Out" stage="Time out" /><input type="number" name="Poll" stage="Poll " /></inputs><onsuccess>56e8cc06-36fb-4e52-a37a-1a257167e92b</onsuccess></stage><stage stageid="2ec4d71b-6335-4e60-b731-4f1ef9b12aab" name="End" type="End"><subsheetid>b7a856b9-8bdf-409e-a6e3-f39b15b62dbe</subsheetid><loginhibit /><display x="15" y="75" /><outputs><output type="flag" name="Found" stage="Found" /></outputs></stage><stage stageid="8288941d-d0fb-40db-b27d-ba0b70c602d4" name="Email user" type="Data"><subsheetid>b7a856b9-8bdf-409e-a6e3-f39b15b62dbe</subsheetid><loginhibit /><display x="-285" y="75" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="66bfec23-b0e2-4727-8ae5-3ad562669d31" name="Email pass" type="Data"><subsheetid>b7a856b9-8bdf-409e-a6e3-f39b15b62dbe</subsheetid><loginhibit /><display x="-285" y="120" /><datatype>password</datatype><initialvalueenc></initialvalueenc><private /><alwaysinit /></stage><stage stageid="56e8cc06-36fb-4e52-a37a-1a257167e92b" name="Monitor Email" type="Code"><subsheetid>b7a856b9-8bdf-409e-a6e3-f39b15b62dbe</subsheetid><loginhibit /><display x="15" y="-15" /><inputs><input type="text" name="Server" expr="[Server]" /><input type="number" name="Port" expr="[IMAP Port]" /><input type="text" name="Username" expr="[Email user]" /><input type="password" name="Password" expr="[Email pass]" /><input type="flag" name="UseSSL" expr="True" /><input type="text" name="SubjectToMatch" expr="[Subject To Match]" /><input type="number" name="TimeoutSeconds" expr="[Time out]" /><input type="number" name="PollSeconds" expr="[Poll ]" /></inputs><outputs><output type="flag" name="Found" stage="Found" /><output type="text" name="MatchedSubject" stage="MatchedSubject" /><output type="text" name="FromAddress" stage="FromAddress" /><output type="text" name="BodyText" stage="BodyText" /></outputs><onsuccess>2ec4d71b-6335-4e60-b731-4f1ef9b12aab</onsuccess><code><![CDATA[Try
    Found = False
    MatchedSubject = ""
    FromAddress = ""
    BodyText = ""

    Dim startUtc As DateTime = DateTime.UtcNow
    Dim deadline As DateTime = startUtc.AddSeconds(CDbl(TimeoutSeconds))
    Dim pollMs As Integer = CInt(CDbl(PollSeconds) * 1000)

    Using client As New MailKit.Net.Imap.ImapClient()

        ' Para demo si tienes problema de certificado:
        client.ServerCertificateValidationCallback = Function(s, c, h, e) True

        Dim options As MailKit.Security.SecureSocketOptions =
            MailKit.Security.SecureSocketOptions.SslOnConnect ' 993

        client.Connect(Server, CInt(Port), options)
        client.Authenticate(Username, Password)

        ' Buscar en TODO el correo
        Dim folder = client.GetFolder(MailKit.SpecialFolder.All)
        folder.Open(MailKit.FolderAccess.ReadWrite)

        While DateTime.UtcNow < deadline AndAlso Found = False

            folder.Check()

            ' NotSeen + subject contiene
            Dim query = MailKit.Search.SearchQuery.NotSeen _
                        .And(MailKit.Search.SearchQuery.SubjectContains(SubjectToMatch))

            Dim uids = folder.Search(query)

            If uids IsNot Nothing AndAlso uids.Count > 0 Then
                ' Revisar desde el más reciente al más antiguo
                For i As Integer = uids.Count - 1 To 0 Step -1
                    Dim uid = uids(i)
                    Dim msg = folder.GetMessage(uid)

                    ' Fecha del mensaje (UTC)
                    Dim msgUtc As DateTime
                    Try
                        msgUtc = msg.Date.UtcDateTime
                    Catch
                        msgUtc = DateTime.UtcNow
                    End Try

                    ' ✅ Solo mensajes recientes desde que empezó el monitor (2 min tolerancia)
                    If msgUtc >= startUtc.AddMinutes(-2) Then
                        Found = True
                        MatchedSubject = If(msg.Subject, "")
                        FromAddress = If(msg.From IsNot Nothing, msg.From.ToString(), "")

                        If msg.TextBody IsNot Nothing AndAlso msg.TextBody <> "" Then
                            BodyText = msg.TextBody
                        ElseIf msg.HtmlBody IsNot Nothing Then
                            BodyText = msg.HtmlBody
                        Else
                            BodyText = ""
                        End If

                        ' Marcar como leído
                        folder.AddFlags(uid, MailKit.MessageFlags.Seen, True)
                        Exit For
                    End If
                Next
            End If

            If Found = False Then
                System.Threading.Thread.Sleep(pollMs)
            End If

        End While

        client.Disconnect(True)
    End Using

Catch ex As Exception
    Dim m As String = ex.Message
    If ex.InnerException IsNot Nothing Then
        m &= " - " & ex.InnerException.Message
    End If
    m &= vbCrLf & "Stack Trace: " & ex.StackTrace
    Throw New Exception(m)
End Try]]></code></stage><stage stageid="fc1339d8-01f1-4b82-a529-0fd2ecc7e0b8" name="Found" type="Data"><subsheetid>b7a856b9-8bdf-409e-a6e3-f39b15b62dbe</subsheetid><display x="-150" y="-15" /><datatype>flag</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="f138d5bd-eff0-43c6-85ff-f50b70e50bc3" name="MatchedSubject" type="Data"><subsheetid>b7a856b9-8bdf-409e-a6e3-f39b15b62dbe</subsheetid><display x="-150" y="30" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="82be5a38-0a7d-4212-b29c-d5ee73c95690" name="FromAddress" type="Data"><subsheetid>b7a856b9-8bdf-409e-a6e3-f39b15b62dbe</subsheetid><display x="-150" y="75" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="11b0d408-473d-4c43-98e0-4ce9cbc3bb66" name="BodyText" type="Data"><subsheetid>b7a856b9-8bdf-409e-a6e3-f39b15b62dbe</subsheetid><display x="-150" y="120" /><datatype>text</datatype><initialvalue /><private /><alwaysinit /></stage><stage stageid="b73e01be-cce2-458b-9d33-46284138ef83" name="Inputs" type="Block"><subsheetid>b7a856b9-8bdf-409e-a6e3-f39b15b62dbe</subsheetid><loginhibit /><display x="-345" y="-45" w="120" h="330" /><font family="Segoe UI" size="10" style="Regular" color="7FB2E5" /></stage><stage stageid="c5318e0d-f5ef-4ea4-9159-2cff4920c9dc" name="Outputs" type="Block"><subsheetid>b7a856b9-8bdf-409e-a6e3-f39b15b62dbe</subsheetid><loginhibit /><display x="-210" y="-45" w="120" h="195" /><font family="Segoe UI" size="10" style="Regular" color="33CCCC" /></stage><stage stageid="8f21cb85-90e2-4829-ad17-25923046f15a" name="Server" type="Data"><subsheetid>b7a856b9-8bdf-409e-a6e3-f39b15b62dbe</subsheetid><loginhibit /><display x="-285" y="-15" /><datatype>text</datatype><initialvalue xml:space="preserve">imap.gmail.com</initialvalue><private /><alwaysinit /></stage><stage stageid="81a60c77-21ba-4351-a4df-b460dea1401f" name="IMAP Port" type="Data"><subsheetid>b7a856b9-8bdf-409e-a6e3-f39b15b62dbe</su